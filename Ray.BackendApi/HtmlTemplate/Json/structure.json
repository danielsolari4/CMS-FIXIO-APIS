{
  "Layout": {
    "Name": "Layout 1",
    "Html": "<div style='display: none'>pingdom-test</div><div class='layout {{layout.class}}'>[{areas}]</div>",
    "Types": [
      {
        "Id": 1,
        "Css": "layout-1",
        "Description": "Full Width",
        "AreasCount": 1
      },
      {
        "Id": 2,
        "Css": "layout-2",
        "Description": "Content/Sidebar",
        "AreasCount": 2
      },
      {
        "Id": 3,
        "Css": "layout-3",
        "Description": "Full Width + Content/Sidebar",
        "AreasCount": 3
      }
    ]
  },
  "Area": {
    "Name": "Area 1",
    "Html": "<div class='area area-temp-{{area.css}} {{area.thematic}}' data-tematica='{{area.backgroundColor}}'>[{titleHtml}]<div class='holder'>[{regions}]</div></div>",
    "HtmlTitle": "<div class='title'><h4>{{area.title}}</h4><a href='{{area.link}}'>{{area.labelLink}}</a></div>",
    "Css": [ "class1", "class2" ],
    "Controls": [],
