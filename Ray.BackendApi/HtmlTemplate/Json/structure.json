  "Component": {
    "Name": "Component",
    "Html": "<div class='component {{component.css}}'>[{titleHtml}] <div class='holder'>[{component}]</div></div>",
    "HtmlTitle": "<div class='badge' style='background-color:{{component.badge.backgroundColor}}'><h4>{{component.badge.title}}</h4></div>",
    "Css": [
      {
        "Name": "component--small",
        "Description": "Simple",
        "Icon": "mdi mdi-image-size-select-small",
        "Id": 1
      },
      {
        "Name": "component--medium",
        "Description": "Imagen Destacada",
        "Icon": "mdi mdi-image-size-select-large",
        "Id": 2
      },
      {
        "Name": "component--big",
        "Description": "Destacado",
        "Icon": "mdi mdi-image-size-select-actual",
        "Id": 3
      },
      {
        "Name": "component--no-image",
        "Description": "No Image",
        "Icon": "mdi mdi-image-off",
        "Id": 4
      }
    ],
    "Types": [
      {
        "Name": "Sección",
        "Control": "SelectNode",
        "Icon": "mdi-file-tree",
        "Type": 10,
        "CategoryId": 3,
        "Html": "<div class='block'><div class='node' data-href='{{Url}}'><div class='image progressive'><div class='loadingImage' style='background: url({{mediaurl}}{{component.Media.Size5Path}})' data-image='{{mediaurl}}{{component.Media.Size2Path}}'></div><div class='overlay'></div></div><div class='text' flowtype min-font='15' max-font='32' font-ratio='25' minimum='256' maximum='1200'><h2>{{component.Title}}</h2></div></div></div>",
        "Css": "",
        "Structure": {
          "Title": "",
          "CategoryId": 0,
          "GalleryId": 0,
          "Html": ""
        }
      },
      {
        "Name": "Nota",
        "Control": "SelectNews",
        "Icon": "mdi-newspaper",
        "Type": 1,
        "CategoryId": 1,
        "Html": "<div class='block' ng-class='styleFunctions.renderStylesComponentsNews(component)'><div class='nota nota-{{component.properties.MediaDiscriminator}} {{component.properties.NodeContentTitleTheme}}' data-href='/{{component.properties.NodeContentDescription}}/{{Url}}_{{Id}}'><div class='image progressive'><div class='loadingImage' style='background: url({{mediaurl}}{{component.properties.MediaSizesPaths.AssetMediaSizePath5}})' data-image='{{mediaurl}}{{component.properties.MediaSizesPaths.AssetMediaSizePath1}}'></div><div class='overlay'></div></div><div class='text' ng-style='component.BackgroundColor && {backgroundColor: component.BackgroundColor}' flowtype min-font='15' max-font='32' font-ratio='25' minimum='256' maximum='1200'><h4>{{component.properties.NodeContentTitle}}</h4><h2 flowtype min-font='20' max-font='32' font-ratio='25' minimum='256' maximum='1200' ng-style='component.FontColor && {color: component.FontColor}'>{{component.properties.Title}}</h2><p>{{component.properties.Description}}</p><h6><span class='date'>Hace <strong>{{component.properties.PublicationDate}}</strong></span><span class='author'>por <a href='{{component.properties.AuthorLink}}'><strong>{{component.properties.AuthorName}}</strong></a></span></h6></div><a class='nota-link' href='/{{component.properties.NodeContentDescription}}/{{Url}}_{{Id}}'>{{component.properties.Title}}</a></div></div>",
        "Css": "",
        "Structure": {
          "Title": "",
          "Link": "",
          "Class": "",
          "AuthorName": "",
          "PublicationDate": "",
          "Description": "",
          "MediaSizesPaths": {
            "Size1Path": "",
            "Size2Path": "",
            "Size3Path": "",
            "Size4Path": "",
            "Size5Path": ""
          },
          "Position": 0,
          "Id": 0,
          "Url": ""
        }
      },
